# Variables used by frontend source code.
# Only REACT_APP_* and VITE_* variables are exposed to browser code, and their
# values are inlined into the public bundle at build time: never put secrets here.
# Rebuild (or restart the dev server) after changes.

# Frontend dev server port
PORT=3001

# Map graph API configuration
# Point this to the running PhantasmaMaps-api host.
REACT_APP_MAPS_API_BASE_URL=http://127.0.0.1:3000
REACT_APP_MAPS_API_TOKEN_SYMBOL=SOUL
REACT_APP_MAPS_API_GRAPH_DEPTH=2
REACT_APP_MAPS_API_GRAPH_EDGE_LIMIT=1200
REACT_APP_MAPS_API_GRAPH_NODE_LIMIT=300
REACT_APP_MAPS_API_GRAPH_TOP_HOLDERS_LIMIT=100
REACT_APP_MAPS_API_REQUEST_TIMEOUT_MS=45000
REACT_APP_MAPS_API_SYNC_STATUS_POLL_INTERVAL_MS=30000
REACT_APP_TOKEN_METADATA_POLL_INTERVAL_MS=60000

# Price polling/backoff tuning in milliseconds
REACT_APP_SOUL_PRICE_BASE_POLL_INTERVAL_MS=300000
REACT_APP_SOUL_PRICE_MAX_BACKOFF_MS=600000

# Direct price sources, used only when the maps API /prices route is unreachable
# (optional overrides)
REACT_APP_SOUL_PRICE_API_URL=
REACT_APP_TRACKED_TOKEN_PRICES_API_URL=
REACT_APP_TRACKED_TOKEN_PRICE_NETWORK=mainnet
REACT_APP_PHANTASMA_EXPLORER_TOKEN_API_URL=

# Explorer URL overrides (optional)
REACT_APP_PHANTASMA_EXPLORER_BASE=
REACT_APP_PHANTASMA_TX_EXPLORER_BASE=

# Public base path for static assets (leave empty for root hosting)
PUBLIC_URL=